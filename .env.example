# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.
# config/settings.py is the ONLY place that reads these variables.
# ──────────────────────────────────────────────────────────────────────────────

# ── Capital ───────────────────────────────────────────────────────────────────
# Starting paper-trading capital in USD.
INITIAL_CAPITAL=10000.0

# ── Universe ──────────────────────────────────────────────────────────────────
# Comma-separated US ticker symbols (no suffix).
TICKERS=AAPL,MSFT,NVDA,GOOGL,META,VZ,CMCSA,AMZN,TSLA,HD,JPM,V,BAC,UNH,JNJ,LLY,CAT,GE,UPS,PG,COST,KO,XOM,CVX,COP

# Benchmark ticker used for the regime filter and all comparison reporting.
BENCHMARK=SPY

# ── Strategy thresholds (§1.3 / §1.4) ────────────────────────────────────────
# Buy only when model probability >= this value.
BUY_BAR=0.60

# Exit (signal exit) when probability drops below this value.
SIGNAL_EXIT=0.45

# Hard stop-loss: exit if position falls this fraction from entry (positive = loss).
STOP_LOSS=0.08

# Hard take-profit: exit if position gains this fraction from entry.
TAKE_PROFIT=0.15

# ── Position / sizing rules (§1.4) ────────────────────────────────────────────
# Maximum number of concurrent open positions.
MAX_POSITIONS=3

# Fraction of total capital always kept in cash (uninvested).
CASH_RESERVE=0.15

# Minimum dollar value of any single trade.
MIN_TRADE_SIZE=10.0

# ── Prediction label (§1.3) ───────────────────────────────────────────────────
# Forward-looking horizon in trading days.
PREDICTION_HORIZON_DAYS=5

# Minimum return threshold to label a move a "win" (as a fraction, not %).
WIN_THRESHOLD=0.01

# ── Costs (§1.6) ──────────────────────────────────────────────────────────────
# Simulated cost per trade as a fraction of trade value (0.2% = 0.002).
SIMULATED_COST_PER_TRADE=0.002

# ── Regime filter (§1.8) ──────────────────────────────────────────────────────
# Look-back window (in trading days) for the benchmark moving average.
REGIME_MA_WINDOW=200

# ── Data paths ────────────────────────────────────────────────────────────────
# These are relative to the project root; override only if you need a different layout.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_MODELS_DIR=data/models

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Section 5: Intelligence Upgrades ──────────────────────────────────────────
# FRED API Key for Macro Economic Data (free at https://fred.stlouisfed.org)
FRED_API_KEY=

# ── Section 7: Notification & Alert Channels ───────────────────────────────────
ALERT_EMAIL_SENDER=your@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password
ALERT_EMAIL_RECIPIENT=recipient@gmail.com


# -- Section 7 Item 2: Telegram Notifications
# Get token from @BotFather on Telegram (send /newbot)
# Get chat ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Free API key at alphavantage.co
ALPHA_VANTAGE_API_KEY=
